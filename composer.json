{
    "name": "omega-mvc/nexus",
    "description": "A collection of classes for general web development, with a particular focus on compatibility, portability and security",
    "homepage": "http://flourishlib.com/",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Will Bond",
            "role": "Developer",
            "homepage": "http://wbond.net/",
            "email": "will@wbond.net"
        }
    ],
    "autoload": {
        "classmap": [
            "."
        ]
    },
    "require": {
        "php": "^8.4"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.9.x-dev"
        }
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.10",
        "phpstan/phpstan": "^2.1",
        "tomasvotruba/type-coverage": "^2.0",
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "cs": "phpcs --standard=phpcs.xml",
        "cs-fix": "phpcbf --standard=phpcs.xml",
        "analyse": "phpstan analyse --configuration=phpstan.neon",
        "test": "phpunit --configuration=phpunit.xml.dist",
        "check": [
            "@cs",
            "@analyse",
            "@test"
        ]
    }
}
